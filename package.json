{
  "name": "sentinel-x",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format:check": "prettier --check \"api/**/*.{js,json,md}\" README.md package.json eslint.config.js",
    "lint": "eslint api --max-warnings=0",
