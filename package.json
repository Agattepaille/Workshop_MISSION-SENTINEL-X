    "check": "npm run lint && npm test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.9"
  }
}
