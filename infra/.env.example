# Modele des secrets — AUCUNE valeur reelle ne doit figurer ici.
#
# Utilisation sur le RPi :
#   cp .env.example /opt/sentinel-x/.env
#   chmod 600 /opt/sentinel-x/.env
#   # puis renseigner chaque valeur

# --- Compte d'administration SSH ---
# Le compte est cree par Raspberry Pi Imager, pas par ce fichier.
SSH_USER=sentinel-x12
SSH_KEY=/home/<utilisateur>/.ssh/id_ed25519_rpi5

# --- Base InfluxDB ---
INFLUXDB_ORG=sentinel
INFLUXDB_BUCKET=sentinel
INFLUXDB_ADMIN_USER=<a_definir>
INFLUXDB_ADMIN_PASSWORD=<mot_de_passe_fort>
INFLUXDB_ADMIN_TOKEN=<token_genere>

# --- Utilisateurs MQTT (crees avec mosquitto_passwd) ---
MOSQUITTO_ESP_USER=esp
MOSQUITTO_ESP_PASSWORD=<a_definir>
MOSQUITTO_API_USER=api
MOSQUITTO_API_PASSWORD=<a_definir>
MOSQUITTO_IA_USER=ia
MOSQUITTO_IA_PASSWORD=<a_definir>

# --- Supervision Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<a_definir>
GRAFANA_VIEWER_USER=equipe
GRAFANA_VIEWER_PASSWORD=<a_definir>

# --- Point d'acces WiFi ---
AP_SSID=<ssid_genere>
AP_PSK=<cle_wpa2_forte>

# --- Certificats (jamais dans Git) ---
# ca.key et server.key restent sur le RPi, chmod 600.
# Seul ca.crt (public) est transmis a l'equipe DEV, hors depot.
