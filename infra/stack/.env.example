# Modele du .env de la stack — AUCUNE valeur reelle ici.
#
# Les secrets vivent dans CREDENTIALS.md (hors depot, chmod 600) et sont
# reportes a la main dans /opt/sentinel-x/stack/.env sur la borne.
# Ce depot ne doit jamais contenir de jeton (regle 1 des invariants).

# Nom de la base InfluxDB : ce n est pas un secret.
INFLUX_DATABASE=alerts

# Jeton operateur InfluxDB 3 (admin). Commun a la base et a l API tant qu
# InfluxDB 3 Core ne sait pas emettre de jeton restreint.
INFLUX_TOKEN=

# Mot de passe de l utilisateur "bridge" du broker MQTT : il ne peut QUE lire
# les capteurs (ACL). Le nom d utilisateur n est pas un secret, il est dans le
# docker-compose.yml. Piege connu : verifier le couple, pas seulement le secret.
MQTT_PASSWORD=
