{
  "uid": "sentinel-supervision",
  "title": "Sentinel-X — Supervision RPi, Docker & MQTT",
  "tags": [
    "sentinel",
    "supervision",
    "infra"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Conteneurs en marche",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUX}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 4
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUX}"
          },
          "query": "from(bucket: \"sentinel\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"docker_container_status\" and r._field == \"running\")\n  |> last()\n  |> filter(fn: (r) => r._value == 1)\n  |> count()\n  |> keep(columns: [\"_value\"])"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Broker MQTT uptime (h)",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUX}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUX}"
          },
          "query": "from(bucket: \"sentinel\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mqtt_consumer\" and r.topic == \"$SYS/broker/uptime\")\n  |> last()\n  |> keep(columns: [\"_value\"])"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Uptime RPi (h)",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUX}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUX}"
          },
          "query": "from(bucket: \"sentinel\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"system\" and r._field == \"uptime\")\n  |> last()\n  |> map(fn: (r) => ({r with _value: r._value / 3600.0}))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "MQTT — messages reçus / envoyés (cumul)",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUX}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUX}"
          },
          "query": "from(bucket: \"sentinel\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mqtt_consumer\" and r.topic == \"$SYS/broker/messages/received\")\n  |> aggregateWindow(every: 30s, fn: last)\n  |> keep(columns: [\"_time\",\"_value\"])"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUX}"
          },
          "query": "from(bucket: \"sentinel\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mqtt_consumer\" and r.topic == \"$SYS/broker/messages/sent\")\n  |> aggregateWindow(every: 30s, fn: last)\n  |> keep(columns: [\"_time\",\"_value\"])"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU (%)",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUX}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUX}"
          },
          "query": "from(bucket: \"sentinel\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"cpu\" and r._field == \"usage_idle\")\n  |> map(fn: (r) => ({r with _value: 100.0 - r._value}))\n  |> aggregateWindow(every: 10s, fn: mean)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "MQTT — charge messages 1min (msg/s)",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUX}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUX}"
          },
          "query": "from(bucket: \"sentinel\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mqtt_consumer\" and r.topic == \"$SYS/broker/load/messages/received/1min\")\n  |> aggregateWindow(every: 30s, fn: mean)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Mémoire utilisée (%)",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUX}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUX}"
          },
          "query": "from(bucket: \"sentinel\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mem\" and r._field == \"used_percent\")\n  |> aggregateWindow(every: 10s, fn: mean)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Disque utilisé (%)",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUX}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUX}"
          },
          "query": "from(bucket: \"sentinel\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"disk\" and r._field == \"used_percent\")\n  |> aggregateWindow(every: 30s, fn: mean)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "MQTT — bytes reçus / envoyés (cumul)",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUX}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUX}"
          },
          "query": "from(bucket: \"sentinel\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mqtt_consumer\" and r.topic == \"$SYS/broker/bytes/received\")\n  |> aggregateWindow(every: 30s, fn: last)\n  |> keep(columns: [\"_time\",\"_value\"])"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUX}"
          },
          "query": "from(bucket: \"sentinel\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mqtt_consumer\" and r.topic == \"$SYS/broker/bytes/sent\")\n  |> aggregateWindow(every: 30s, fn: last)\n  |> keep(columns: [\"_time\",\"_value\"])"
        }
      ]
    },
    {
      "type": "table",
      "title": "État des conteneurs",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUX}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUX}"
          },
          "query": "from(bucket: \"sentinel\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"docker_container_status\" and (r._field == \"running\" or r._field == \"oomkilled\" or r._field == \"restarted\"))\n  |> last()\n  |> pivot(rowKey:[\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")"
        }
      ]
    }
  ],
  "__inputs": [
    {
      "name": "DS_INFLUX",
      "label": "InfluxDB",
      "description": "",
      "type": "datasource",
      "pluginId": "influxdb",
      "pluginName": "InfluxDB"
    }
  ]
}